# ══════════════════════════════════════════════════════════════════════
#  大文件：绝不进 git
# ══════════════════════════════════════════════════════════════════════
# 原始录屏 2.5 GB —— 唯一真值来源，磁盘上必须留着，但一旦提交进历史就清不掉
records/

# 抽帧缓存 1.5 GB —— 可由 collect_glyphs.frame() / axis_extract_E.py 重新生成
frames/

# 给用户看过的核对图 / 诊断图 51 MB —— 文档里以文件名引用，可按需重出
samples/

# 第三方包副本（mss 10.2.0 解包）—— 可由 python tools/archive/install_mss.py 重装
vendor/

# ══════════════════════════════════════════════════════════════════════
#  一次性诊断产物（P2/P3 整理期与实机取证期的临时落盘）
#  ⚠️ 与 out/ 里的模型/数据集/模板**不同**：这些是"某次实验的中间表"，没有读取者
#     （审计见 docs/无用文件审计.md §5）。先忽略，等确认后再删。
# ══════════════════════════════════════════════════════════════════════
out/M_*.csv
out/p2_*
# P1：某台机器/某种显示模式下的 HUD 框标定（机器相关，不该进 git；
#    内容形如 {"screen":[2880,1800],"box":[285,2353,365,2880],"bar":[323,335]}）
out/live_calib.json
# P1：实机采集落盘的逐帧诊断表（临时取证产物）
out/p1_*
# 无控制台运行的落盘日志（源码模式被无控制台启动时也会生成，别提交）
/运行日志.txt

# ══════════════════════════════════════════════════════════════════════
#  exe 打包产物（几百 MB，绝不进 git）
#  ⚠️ 但 **spec 与构建脚本要进**：hud_pack.spec / build_exe.py
#     （构建命令见 docs/EXE打包.md，产物位置 dist/）
# ══════════════════════════════════════════════════════════════════════
dist/
build/
*.spec.bak

# onefile exe 自解包失败时留下的空目录（PyInstaller 用**低完整性标签**建它防篡改，
# 普通权限进程连删都删不掉，和上面的 .piptmp/ 同一类现象）—— 重新构建/重启后可再试删
out/exe_tmp/

# pip 建出来的、权限坏掉删不掉的空目录
.piptmp/

# ══════════════════════════════════════════════════════════════════════
#  Python 缓存
# ══════════════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ══════════════════════════════════════════════════════════════════════
#  临时 / 报告
# ══════════════════════════════════════════════════════════════════════
out/acl_reports/
.DS_Store
Thumbs.db

# ══════════════════════════════════════════════════════════════════════
#  ⚠️ 注意：out/ 不要整个忽略
#  模型（digit_cnn*.pt/.onnx）、数据集（digit_dataset*.npz）、
#  模板库（axis_top_bank_E.npz / axis_templates*/）、真值 JSON 都在里面，
#  是核心资产，总共只有 ~14 MB。
# ══════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════
#  第三方游戏资料库（68 MB / 312 文件 / 13 种语言）—— 不进 git
#  来源：StarRailRes 项目的 index_min（用户提供，本地数据源）
#  用途：仅 `extract_skills_L2.py` 读它的 `index_min/cn/`（约 4.6 MB）
#        用于抽欢愉队 4 人的技能文本
#  为什么不提交：第三方素材 + 体量大；且**派生产物已入库**：
#        out/skills_L2.json、out/L2_damage_ledger.json、out/L2_damage_ledger.md
#        （派生脚本 extract_skills_L2.py / make_damage_ledger_L2.py 也在库里）
#  注意：extract_skills_L2.py 有**兜底数据源** `D:/project/btdsh/`，
#        所以本目录缺失时该脚本仍能工作（部分角色可能需要重新获取）
#  重建：重新放置 StarRailRes 的 index_min 到此路径即可
# ══════════════════════════════════════════════════════════════════════
StarRailRes-index_min/

# 整理期一次性临时文件（提交信息、探针截图等）
out/p3_commit_msg.txt
out/p3_*.log
out/p3b_commit_msg.txt

# 模型/模板库的临时备份（每份几十 MB，不要进 git）
*.npz.bak*
*.onnx.bak*
*.pt.bak*

# 中间产物隔离区（用户 2026-10-02）：确认没用后手工删整个目录
rubbish/

# 本机专用的 ffmpeg 兜底路径（含用户名，不能发布）
ffmpeg_path_local.py

# 模型/数据的临时备份（不要进仓库）
*.bak
*.bak_*
*.bak.*
